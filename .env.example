# Copia a .env para desarrollo local. NUNCA subas el .env real a Git.
# En producción (Render) estos valores van en Environment, no en el repo.

PORT=3000
SITE_URL=http://localhost:3000

# Base de datos: si están vacías se usa SQLite local (blog.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sesiones del admin (si falta, se genera uno persistente en la BD).
JWT_SECRET=

# Login del panel /admin (usuario + contraseña).
# Para desarrollo local: ADMIN_PASSWORD=Admin123!
# Para producción: usa ADMIN_PASSWORD_HASH (bcrypt) — ver DEPLOY.md.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Clave que usa Muse para publicar por API (header X-Publish-Key).
# En local, este repo ya trae una generada en PUBLISH_KEY.txt (chmod 600).
PUBLISH_KEY=
